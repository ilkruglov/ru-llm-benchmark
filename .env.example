# Copy to .env and fill in. Never commit .env (it is git-ignored).
# chmod 600 .env

# --- self-hosted Qwen endpoints (OpenAI-compatible) ---
QWEN27B_URL=https://your-qwen-27b-host.example
QWEN27B_API_KEY=
QWEN35B_URL=https://your-qwen-35b-host.example
QWEN35B_API_KEY=
QWEN122B_URL=https://your-qwen-122b-host.example
QWEN122B_API_KEY=

# --- managed providers ---
GROQ_API_KEY=
DEEPSEEK_API_KEY=
DEEPINFRA_API_KEY=
NEURALDEEP_API_KEY=

# --- optional overrides ---
# NEURALDEEP_URL=https://api.neuraldeep.ru/v1/chat/completions
# GROQ_PROXY_URL=https://api.groq.com/openai/v1   # set if Groq needs a regional proxy
